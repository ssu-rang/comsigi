COMSIGI_DATABASE_URL=sqlite+aiosqlite:///./comsigi.db
COMSIGI_CORS_ORIGINS=["http://localhost:8443","http://127.0.0.1:8443","http://localhost:4173","http://127.0.0.1:4173"]
COMSIGI_DEVICE_TIMEOUT_SECONDS=30
COMSIGI_SEAT_TIMEOUT_SECONDS=30
COMSIGI_SWEEP_INTERVAL_SECONDS=1
COMSIGI_ADMIN_TOKEN_TTL_SECONDS=28800
# 관리자 생성/비밀번호 변경 CLI 전용. 실제 비밀번호는 서버 환경변수 또는 .env에만 설정합니다.
# COMSIGI_ADMIN_PASSWORD=
COMSIGI_WS_HEARTBEAT_SECONDS=15
COMSIGI_WS_QUEUE_SIZE=64
COMSIGI_MAX_WS_CONNECTIONS=1000
