# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.test-tmp/
.mypy_cache/
.ruff_cache/
.pyre/

# Virtual environments
.venv/
venv/
env/
ENV/

# Local environment and credentials
.env
.env.*
!.env.example
.aws/
*.pem
*.key

# Build and package artifacts
build/
dist/
*.egg-info/
.eggs/

# Test coverage
.coverage
.coverage.*
htmlcov/
coverage.xml

# Local runtime data
*.log
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.db-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal

# Frontend dependencies, caches, and local files
/frontend/**/node_modules/
/frontend/**/.cache/
/frontend/**/.env*
!/frontend/**/.env.example
/frontend/**/.vite/
/frontend/**/vite.config.*.timestamp-*
/frontend/**/*.tsbuildinfo
/frontend/**/*-debug.log*
/frontend/**/logs/
/frontend/**/.claude-replay.*
/frontend/**/.tmp-*

# Figma Make generated context and platform-managed state
/frontend/.figma/design-context/
/frontend/.plugins/
/frontend/.opencode-skills/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
